# Copie este arquivo para .env e ajuste os valores.

# Porta da API (padrao 3001).
PORT=3001

# Conexao com o PostgreSQL.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://hand2hand:hand2hand@localhost:5432/hand2hand

# Segredo para assinar os tokens JWT.
JWT_SECRET=eu gosto muito do professor mateus
